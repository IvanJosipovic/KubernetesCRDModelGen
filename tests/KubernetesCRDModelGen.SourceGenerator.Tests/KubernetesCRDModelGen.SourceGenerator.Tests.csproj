<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <WarningsAsErrors>$(WarningsAsErrors);CS8785</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KubernetesClient" Version="19.0.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="System.Formats.Asn1" Version="10.0.11" />
        <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
        <PackageReference Include="YamlDotNet" Version="17.1.0" />
        <PackageReference Include="YamlDotNet.System.Text.Json" Version="1.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\KubernetesCRDModelGen.Base\KubernetesCRDModelGen.Base.csproj" />
        <ProjectReference Include="..\..\src\KubernetesCRDModelGen.SourceGenerator\KubernetesCRDModelGen.SourceGenerator.csproj" />
        <None Include="kubevirts.kubevirt.io.yaml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
